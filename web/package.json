{
  "name": "@tide-framework/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "concurrently --kill-others --names api,web --prefix-colors blue,green \"cd .. && uv run --extra api --extra client tide serve applications/invoicing --demo --role sales_clerk --role auditor --port 8000\" \"vite --open\"",
    "dev:sqlserver": "concurrently --kill-others --names api,web --prefix-colors blue,green \"cd .. && uv run --extra api --extra client --extra sqlserver tide serve applications/invoicing --database-env --role sales_clerk --role auditor --port 8000\" \"vite --open\"",
    "build": "tsc -b && vite build",
    "check": "tsc -b && vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.4",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
