{
  "operations": [
    {
      "operation": "create_application",
      "application_id": "contacts",
      "name": "TIDE Contacts"
    },
    {
      "operation": "define_entity",
      "entity": "crm.Company",
      "label": "Companies",
      "display": "{code} - {name}",
      "fields": [
        {"name": "id", "type": "integer", "primary_key": true},
        {
          "name": "code",
          "type": "string",
          "required": true,
          "unique": true,
          "length": 20
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "length": 120
        },
        {"name": "website", "type": "string", "length": 200},
        {"name": "active", "type": "boolean", "default": true}
      ],
      "list_permission": "crm.company.read",
      "read_permission": "crm.company.read",
      "create_permission": "crm.company.write",
      "update_permission": "crm.company.write",
      "delete_permission": "crm.company.delete",
      "audit_permission": "crm.company.audit",
      "expose_rest": ["list", "get", "create", "update", "delete"],
      "expose_mcp": [
        "schema",
        "record",
        "audit",
        "search",
        "create",
        "update",
        "delete"
      ]
    },
    {
      "operation": "define_entity",
      "entity": "crm.Contact",
      "label": "Contacts",
      "display": "{name}",
      "fields": [
        {"name": "id", "type": "integer", "primary_key": true},
        {
          "name": "name",
          "type": "string",
          "required": true,
          "length": 120
        },
        {"name": "email", "type": "string", "length": 254},
        {"name": "phone", "type": "string", "length": 40},
        {
          "name": "company",
          "type": "reference",
          "target": "crm.Company",
          "required": true,
          "on_delete": "restrict"
        },
        {
          "name": "status",
          "type": "choice",
          "choices": ["active", "archived"],
          "default": "active",
          "readonly": true
        },
        {"name": "archived_at", "type": "datetime", "readonly": true},
        {
          "name": "archived_by",
          "type": "string",
          "readonly": true,
          "length": 120
        }
      ],
      "list_permission": "crm.contact.read",
      "read_permission": "crm.contact.read",
      "create_permission": "crm.contact.write",
      "update_permission": "crm.contact.write",
      "delete_permission": "crm.contact.delete",
      "audit_permission": "crm.contact.audit",
      "expose_rest": ["list", "get", "create", "update", "delete"],
      "expose_mcp": [
        "schema",
        "record",
        "audit",
        "search",
        "create",
        "update",
        "delete"
      ]
    },
    {
      "operation": "define_state_transition",
      "entity": "crm.Contact",
      "action": "archive",
      "label": "Archive contact",
      "state_field": "status",
      "from_values": ["active"],
      "to_value": "archived",
      "permission": "crm.contact.archive",
      "stamp_datetime_field": "archived_at",
      "stamp_principal_field": "archived_by",
      "expose_rest": true,
      "expose_mcp": true
    },
    {
      "operation": "define_role",
      "role": "contact_editor",
      "grants": [
        "crm.company.read",
        "crm.company.write",
        "crm.company.delete",
        "crm.company.audit",
        "crm.contact.read",
        "crm.contact.write",
        "crm.contact.delete",
        "crm.contact.audit",
        "crm.contact.archive"
      ]
    },
    {
      "operation": "define_role",
      "role": "contact_viewer",
      "grants": ["crm.company.read", "crm.contact.read"]
    }
  ]
}
