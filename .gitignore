# Local assistant/session tooling
.remember/

__pycache__/
*.py[cod]
*.egg-info/
.coverage
# One data file per worker while `pytest -n 4 --cov` runs. A finished run
# combines and removes them; a killed or interrupted one does not, and
# `.coverage` on its own does not match `.coverage.<host>.<pid>.<random>`.
# Deliberately not `.coverage*`, which would also swallow a `.coveragerc`.
.coverage.*
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pycache/
.venv/
.uv-cache/
.npm-cache/
build/
dist/
output/
tmp/
# Local identity stores, as a pattern rather than a list. Each application gets
# its own store, and this repository is public: the Contacts shortcut created
# `.tide/contacts-local-auth.sqlite3`, which was not on the per-file list, so
# `.tide/` became untracked content one `git add -A` away from publishing an
# administrator's password hash. A third application must not need an edit here.
.tide/*auth*.sqlite3*
# Credentials the end-to-end journeys create for one run.
.tide/e2e-credentials.json

# Web renderer build and test artifacts
web/node_modules/
web/.npm-cache/
web/dist/
web/playwright-report/
web/test-results/
