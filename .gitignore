# Local assistant/session tooling
.remember/

__pycache__/
*.py[cod]
*.egg-info/
.coverage
# One data file per worker while `pytest -n 4 --cov` runs. A finished run
# combines and removes them; a killed or interrupted one does not, and
# `.coverage` on its own does not match `.coverage.<host>.<pid>.<random>`.
# Deliberately not `.coverage*`, which would also swallow a `.coveragerc`.
.coverage.*
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pycache/
.venv/
.uv-cache/
.npm-cache/
build/
dist/
output/
tmp/
# Local identity stores, as a pattern rather than a list. Each application gets
# its own store, and this repository is public: the Contacts shortcut created
# `.tide/contacts-local-auth.sqlite3`, which was not on the per-file list, so
# `.tide/` became untracked content one `git add -A` away from publishing an
# administrator's password hash. A third application must not need an edit here.
.tide/*auth*.sqlite3*
# Credentials the end-to-end journeys create for one run.
.tide/e2e-credentials.json
# Receipts and journals a Designer save leaves beside the project it wrote to,
# which for a checked-in application means inside `applications/<name>/`. Both
# rules above are anchored at this file, so neither reached there: using Studio
# on the reference application produced untracked content in the application
# tree, which is the same one-`git add -A`-away shape as the identity stores.
# `**/` rather than a path, because a fourth application must not need an edit.
**/.tide/designer/

# Claude Design sync: staged converter scripts, generated bundle, machine
# state. The durable inputs under `.design-sync/` -- config.json, NOTES.md,
# conventions.md, previews/, overrides/ -- are committed; everything below is
# regenerated per run or per clone.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Web renderer build and test artifacts
web/node_modules/
web/.npm-cache/
web/dist/
web/playwright-report/
web/test-results/
