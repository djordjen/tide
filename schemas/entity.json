    "TransitionSource": {
      "additionalProperties": false,
      "description": "The one place an action's effect on a state field is declared.\n\n`from`/`to` name states of a `choice` field the workflow owns, and the\ncompiler derives the action's state guard from `from`. `locks_record`\nsays that arriving at `to` freezes the ordinarily writable fields, which\nis what four copies of `immutable_when: \"status != 'draft'\"` used to say\nby hand. `stamp` names the fields the handler records the transition in;\nthe compiler checks them rather than writing them, so the handler stays\nthe only thing that mutates a record.",
      "properties": {
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "From"
        },
        "to": {
          "minLength": 1,
          "title": "To",
          "type": "string"
        },
        "locks_record": {
          "default": false,
          "title": "Locks Record",
          "type": "boolean"
        },
        "stamp": {
          "additionalProperties": {
            "enum": [
              "now",
              "principal"
            ],
            "type": "string"
          },
          "title": "Stamp",
          "type": "object"
        }
      },
      "required": [
        "field",
        "from",
        "to"
      ],
      "title": "TransitionSource",
      "type": "object"
    },
